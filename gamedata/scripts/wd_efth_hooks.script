local installed = false
local owned = setmetatable({}, { __mode = "k" })

function install()
    if installed then return end

    -- Loading the UI first deliberately permits WD to cache its original builders.
    -- Hook the public creation method instead of modifying private upvalues.
    local ui = d_promin_ui
    local renderer = wd_efth_ui
    local health_page = d_promin_config.HEALTH_PAGE
    local cls = ui.UIPromin
    assert(cls and type(cls.ensure_page) == "function", "WD EFTH: unsupported UIPromin.ensure_page")
    assert(type(ui.get_ui) == "function" and type(ui.get_page) == "function",
        "WD EFTH: unsupported Promin UI accessors")

    local original_ensure = cls.ensure_page
    local original_get_ui = ui.get_ui

    cls.ensure_page = function(self, page_id)
        if page_id ~= health_page then
            return original_ensure(self, page_id)
        end
        local handle = self.pages[page_id]
        if handle and owned[handle] then return handle end
        if handle then
            -- An instance may have been constructed before on_game_start.
            -- Hide its old widgets before replacing that page once.
            handle.set_visible(false)
            self.pages[page_id] = nil
        end
        -- WD keeps separate page caches and contexts for each theme.
        handle = renderer.build(self.ctx)
        self.pages[page_id] = handle
        if handle then
            owned[handle] = true
            handle.set_visible(page_id == ui.get_page() and self.powered_state ~= false)
        end
        return handle
    end

    ui.get_ui = function(...)
        local instance = original_get_ui(...)
        local page_id = ui.get_page()
        if page_id == health_page then
            local handle = instance.pages[page_id]
            if not handle or not owned[handle] then
                instance:apply_page()
            end
        end
        return instance
    end
    installed = true
end

function on_game_start()
    install()
    wd_efth_watch.install()
end
