local px = d_promin_config.get_px()
local health = d_promin_health_ui
local set_shown = wd_screen.set_shown
local place = wd_screen.place_widget
local soft = wd_panel.place_soft_fill
local LIMBS = {
    { "head", "HEAD", 425, 80, 410, "head" },
    { "torso", "TORSO", 425, 158, 202, "torso" },
    { "stomach", "STOMACH", 633, 158, 202, "pelvis" },
    { "arm_left", "L ARM", 425, 236, 202, "leftarm" },
    { "arm_right", "R ARM", 633, 236, 202, "rightarm" },
    { "leg_left", "L LEG", 425, 314, 202, "leftleg" },
    { "leg_right", "R LEG", 633, 314, 202, "rightleg" },
}
local VITALS = {
    { "health", "heart" }, { "stamina", "stamina" },
    { "psy", "psy" }, { "radiation", "rad" },
}
local NEEDS = { { "energy", "food" }, { "hydration", "water" }, { "sleep", "sleep" }, { "weight", "weight" } }

local function new_text(page, x, y, width, height, chars, align, kit)
    kit = kit or page.kit
    local slot = kit.new_text({ chars = chars or 20, width = px.w(width), height = px.h(height), align = align })
    slot.place(px.x(x), px.y(y))
    slot.rect = { x, y, width, height }
    page.cells[#page.cells + 1] = slot
    return slot
end

local function show_text(slot, value, role)
    slot.text = value
    slot.show(value, role or "text")
end

local function image(page, texture, x, y, w, h, role)
    local slot = page.kit.new_image(texture, role or "text")
    slot.rect = { x, y, w, h }
    place(slot.widget, px.x(x), px.y(y), px.w(w), px.h(h))
    page.images[#page.images + 1] = slot
    return slot
end

local function new_bar(page, x, y, w, h)
    local bar = page.kit.new_bar({ level = "text", inset = 0 })
    bar.place(px.x(x), px.y(y), px.w(w), px.h(h))
    page.bars[#page.bars + 1] = bar
    return bar
end

local function show_bar(page, bar, ratio, role)
    page.kit.set_role(bar.level, role or "text")
    bar.set_ratio(ratio)
    bar.set_visible(ratio > 0)
end

local function number(page, x, y, width, heights, align, kit)
    local group = { lines = {}, heights = heights, width = width, kit = kit or page.kit }
    for _, h in ipairs(heights) do
        group.lines[#group.lines + 1] = new_text(page, x, y + heights[1] - h, width, h, 20, align, kit)
    end
    return group
end

local function show_number(group, value, role, available)
    local index = #group.lines
    for i, h in ipairs(group.heights) do
        if group.kit.measure(value, px.h(h)) <= px.w(available or group.width) then index = i; break end
    end
    for i, slot in ipairs(group.lines) do slot.set_visible(i == index) end
    group.text, group.active = value, group.lines[index]
    show_text(group.active, value, role)
    return group.heights[index]
end

local function limb_role(ratio)
    if ratio <= 0.25 then return "crit" end
    if ratio <= 0.5 then return "warn" end
    return "text"
end

local function effects(page, x, y, width)
    local group = { x = x, y = y, width = width, order = {} }
    for _, name in ipairs(wd_efth_data.EFFECTS) do
        local slot = {
            icon = image(page, "ui_efth_hud_effect_" .. name, x, y + 37, 24, 22, "art"),
            count = new_text(page, x, y, 18, 10, 3),
            small_count = new_text(page, x, y, 12, 8, 3),
        }
        group[name] = slot
        group.order[#group.order + 1] = name
    end
    return group
end

local function update_effects(page, group, state)
    local active = 0
    for _, name in ipairs(group.order) do
        local value, slot = state[name], group[name]
        slot.count.set_visible(false); slot.small_count.set_visible(false)
        set_shown(slot.icon, value ~= nil and value.count > 0)
        if value and value.count > 0 then active = active + 1 end
    end
    local dense = active > math.floor(group.width / 32)
    local size, step = dense and 16 or (page.large and 24 or 22), dense and 24 or 32
    local columns = math.floor(group.width / step)
    local index = 0
    for _, name in ipairs(group.order) do
        local value, slot = state[name], group[name]
        if value and value.count > 0 then
            local x = group.x + index % columns * step
            local y = group.y + (dense and 31 or 37) + math.floor(index / columns) * 17
            slot.icon.rect = { x, y, size, size * 22 / 24 }
            place(slot.icon.widget, px.x(x), px.y(y), px.w(size), px.h(size * 22 / 24))
            local alpha = 255
            if value.expiring then alpha = math.floor(255 * (0.35 + 0.65 * (math.sin(3 * time_global() / 1000) + 1) / 2)) end
            local level = d_promin_config.get_ui_level()
            slot.icon.widget:SetTextureColor(GetARGB(alpha, level, level, level))
            if value.count > 1 then
                local count = dense and slot.small_count or slot.count
                count.place(px.x(x + (dense and 12 or 17)), px.y(y + (dense and 8 or 13)))
                show_text(count, "x" .. math.min(value.count, 99))
            end
            index = index + 1
        end
    end
end

local function hide_content(page)
    for _, slot in ipairs(page.cells) do slot.set_visible(false) end
    for _, slot in ipairs(page.images) do set_shown(slot, false) end
    for _, bar in ipairs(page.bars) do bar.set_visible(false) end
    for _, box in ipairs(page.boxes) do box.set_visible(false) end
end

local function build_vitals(page)
    local h = page.large and 46 or 40
    for i, spec in ipairs(VITALS) do
        local key = spec[1]
        local x, y = 25 + (i - 1) % 2 * 192, 80 + math.floor((i - 1) / 2) * 146
        local label_h = page.large and 19 or 17
        local tile = {
            x = x, y = y,
            label = image(page, "wd_large_label_" .. key, x + 14, y + 12, 197 / 35 * label_h, label_h, "meta"),
            icon = image(page, "wd_large_icon_" .. spec[2], x + 134, y + 10, 40, 40),
            number = number(page, x + 14, y + 98 - h, 160, { h, 30, 20 }, nil, page.digits_kit),
            unit = new_text(page, x + 14, y + 78, 40, page.large and 18 or 16, 3),
            bar = new_bar(page, x + 16, y + 113, 156, 12),
        }
        page.vitals[key] = tile
    end
    local radiation = page.vitals.radiation
    radiation.notice = {
        new_text(page, radiation.x + 14, radiation.y + 50, 160, page.large and 24 or 20, 8),
        new_text(page, radiation.x + 14, radiation.y + 78, 160, page.large and 24 or 20, 8),
    }
    local stamina = page.vitals.stamina
    stamina.cap = page.kit.new_soft_fill("border", wd_panel.SOFT_FILLS.bar)
    stamina.tick = page.kit.new_soft_fill("text", wd_panel.SOFT_FILLS.line_v)
    page.images[#page.images + 1] = stamina.cap; page.images[#page.images + 1] = stamina.tick
    stamina.cap_rect = { x = px.x(stamina.x + 16), w = px.w(156), y = px.y(stamina.y + 113), h = px.h(12),
        tick_y = px.y(stamina.y + 107), tick_w = px.w(3), tick_h = px.h(24) }
end

local function show_vital(page, key, ratio, value, unit, role)
    local tile = page.vitals[key]
    local unit_h = page.large and 18 or 16
    local reserve = page.kit.measure(unit, px.h(unit_h)) / px.w(1) + 4
    local height = show_number(tile.number, value, role, 160 - reserve)
    local width = page.digits_kit.measure(value, px.h(height))
    tile.unit.place(px.x(tile.x + 18) + width, px.y(tile.y + 78))
    show_text(tile.unit, unit, role)
    show_bar(page, tile.bar, ratio, role)
    page.kit.set_role(tile.icon, "text"); set_shown(tile.icon, true)
    page.kit.set_role(tile.label, "meta"); set_shown(tile.label, true)
end

local function update_vitals(page, state, conditions)
    for _, key in ipairs({ "health", "stamina", "psy" }) do
        local value = key == "health" and state.ratio or state.needs[key] or 0
        show_vital(page, key, value, tostring(health.get_percent(value)), "%", d_promin_config.get_state_role(value))
    end
    local msv = wd_vitals.get_radiation_msv()
    local stamina = page.vitals.stamina
    local cap = conditions and wd_vitals.get_stamina_cap(conditions, msv) or 1
    health.place_stamina_cap(stamina, cap, 156)
    set_shown(stamina.cap, cap < 1); set_shown(stamina.tick, cap < 1)
    local tile, readable = page.vitals.radiation, wd_geiger.is_dose_readable()
    for _, line in ipairs(tile.notice) do line.set_visible(false) end
    if readable then
        show_vital(page, "radiation", state.needs.radiation or 0, tostring(msv), "mSv",
            d_promin_config.get_state_role(state.needs.radiation or 0, true))
    else
        for _, line in ipairs(tile.number.lines) do line.set_visible(false) end
        tile.unit.set_visible(false); tile.bar.set_visible(false)
        page.kit.set_role(tile.icon, "dim"); set_shown(tile.icon, true)
        page.kit.set_role(tile.label, "dim"); set_shown(tile.label, true)
        show_text(tile.notice[1], "MODULE", "dim"); show_text(tile.notice[2], "REQUIRED", "dim")
    end
end

local function build_needs(page)
    for i, spec in ipairs(NEEDS) do
        local x, y = 25 + (i - 1) % 2 * 192, 376 + math.floor((i - 1) / 2) * 90
        page.needs[spec[1]] = {
            icon = image(page, "wd_large_icon_" .. spec[2], x + 12, y + 21, 44, 44),
            value = number(page, x + 68, y + 20, 108, page.large and {42, 30, 20} or {36, 26, 18}),
        }
    end
end

local function update_needs(page, state, conditions)
    for _, spec in ipairs(NEEDS) do
        local key, text, role = spec[1], "--", "dim"
        if key == "weight" and conditions then
            local total, maximum = wd_vitals.get_carry_weight(conditions)
            text = string.format("%d/%d", math.floor(total + 0.5), math.floor(maximum + 0.5))
            role = total > maximum and "crit" or "text"
        elseif key ~= "weight" and state.needs[key] then
            text = string.format("%d%%", health.get_percent(state.needs[key]))
            role = d_promin_config.get_state_role(state.needs[key])
        end
        local slot = page.needs[key]
        page.kit.set_role(slot.icon, text == "--" and "dim" or "text"); set_shown(slot.icon, true)
        show_number(slot.value, text, role)
    end
end

local function build_geiger(page)
    local function row(y, icon)
        return {
            icon = image(page, "wd_large_icon_" .. icon, 437, y + 12, 28, 28),
            label = image(page, "wd_large_label_unavailable", 477, y + 10, 238, 30),
            unit = image(page, "wd_large_geiger_unit", 677, y + 18, 48, 18, "art"),
            value = new_text(page, 741, y + 10, 80, page.large and 30 or 26, 11, "right"),
        }
    end
    page.geiger = { reading = row(400, "rad"), shield = row(500, "prot_rad"),
        bar = new_bar(page, 439, 462, 382, 10),
        marker = page.kit.new_soft_fill("text", wd_panel.SOFT_FILLS.line_v) }
    page.images[#page.images + 1] = page.geiger.marker
end

local function scale_reading(value)
    if value <= 10 then return 0 end
    return clamp(math.log10(value / 10) / 2, 0, 1)
end

local function update_geiger(page, conditions)
    local linked = conditions ~= nil and wd_geiger.is_linked()
    local reading, shield, state = 0, 0, health.GEIGER_OFF
    if linked then
        reading, shield = wd_geiger.get_exact_reading(), wd_geiger.get_shield(conditions)
        state = health.GEIGER_STATES[reading <= 0 and "clear" or (reading > shield and "leaking" or "held")]
    end
    for key, value in pairs({reading = reading, shield = shield}) do
        local row, label = page.geiger[key], state[key]
        page.kit.set_image(row.label, health.get_label_id(label.text, "wd_large_label_"))
        page.kit.set_role(row.label, label.role); set_shown(row.label, true)
        page.kit.set_role(row.icon, label.role); set_shown(row.icon, true)
        show_text(row.value, linked and string.format("%d", clamp(math.floor(value), -999, 9999)) or label.value, label.role)
        set_shown(row.unit, linked)
    end
    show_bar(page, page.geiger.bar, linked and scale_reading(reading) or 0, state.reading.role)
    local ratio = scale_reading(shield)
    soft(page.geiger.marker, px.x(439 + 382 * ratio - 1.5), px.y(456), px.w(3), px.h(22))
    set_shown(page.geiger.marker, linked)
end

function build(ctx)
    local page = { visible = false, large = ctx.theme == d_promin_config.LARGE_THEME,
        cells = {}, images = {}, bars = {}, boxes = {}, limbs = {}, mannequin = {}, vitals = {}, needs = {} }
    page.chrome = d_promin_chrome_ui.build({ init = ctx.init, wnd = ctx.wnd, theme = ctx.theme,
        bg_tex = page.large and "wd_efth_background_large" or "wd_efth_background", title_tex = health.TITLE_TEXTURE })
    page.kit = page.chrome.page_kit
    page.digits_kit = d_promin_chrome_ui.new_kit(ctx.wnd, page.kit and page.kit.style, d_promin_config.DIGITS_FONT)
    if not page.digits_kit then page.kit = nil end
    page.allow_geiger = wd_core.throttle(wd_geiger.REFRESH_MS)
    page.allow_needs = wd_core.throttle(health.SLOW_REFRESH_MS)
    if page.kit then
        build_vitals(page); build_needs(page); build_geiger(page)
        for _, spec in ipairs(LIMBS) do
            local name, label, x, y, width, part = unpack(spec)
            local tile = {
                rect = {x, y, width, 72},
                label = new_text(page, x + 14, y + 10, 84, page.large and 18 or 16, 7),
                hp = number(page, x + width - 110, y + 7, 96, page.large and {26, 18} or {22, 16}, "right"),
                bar = new_bar(page, x + 14, y + 65, width - 28, 4),
                effects = effects(page, x + 14, y, width - 28),
                border = page.kit.new_box({ border = "warn" }),
            }
            tile.name = label
            tile.border.place(px.x(x), px.y(y), px.w(width), px.h(72))
            page.boxes[#page.boxes + 1] = tile.border
            page.limbs[name] = tile
            local p = d_promin_bio_large_baked.PARTS[part]
            page.mannequin[name] = image(page, "wd_large_part_" .. part,
                964 + (p.x - 964) * 0.86, 168 + (p.y - 95) * 0.86, p.w * 0.86, p.h * 0.86)
        end
        page.effect_label = new_text(page, 873, 90, 181, page.large and 18 or 16, 14)
        page.effects = effects(page, 873, 80, 181)
    end

    function page.update()
        if not page.visible then return end
        page.chrome.update()
        if not page.kit then return end
        local state = wd_efth_data.snapshot()
        if not state then hide_content(page); page.has_data = false; return end
        local conditions = wd_vitals.get_conditions()
        update_vitals(page, state, conditions)
        if not page.has_data or page.allow_needs() then update_needs(page, state, conditions) end
        if not page.has_data or page.allow_geiger() then update_geiger(page, conditions) end
        page.has_data = true
        for _, spec in ipairs(LIMBS) do
            local name, limb = spec[1], state.limbs[spec[1]]
            local tile, role = page.limbs[name], limb_role(limb.ratio)
            show_text(tile.label, tile.name, role == "text" and "meta" or role)
            show_number(tile.hp, string.format("%d/%d", math.floor(limb.hp), math.floor(limb.maximum)), role)
            show_bar(page, tile.bar, limb.ratio, role)
            tile.border.set_role(role); tile.border.set_visible(role ~= "text")
            update_effects(page, tile.effects, limb.effects)
            page.kit.set_role(page.mannequin[name], role)
            set_shown(page.mannequin[name], limb.hp > 0)
        end
        show_text(page.effect_label, "GLOBAL EFFECTS", "meta")
        update_effects(page, page.effects, state.global_effects)
    end
    function page.set_visible(visible)
        page.visible = visible
        page.chrome.set_visible(visible)
        page.has_data = false
        if visible then page.update() elseif page.kit then hide_content(page) end
    end
    function page.repaint()
        page.chrome.repaint()
        if page.digits_kit then page.digits_kit.repaint() end
        page.update()
    end
    page.set_visible(true)
    return page
end
